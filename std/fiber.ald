pub type MapOptions = { concurrency?: Number }

// Explicitly request all input operations to be eligible to run concurrently.
pub let unbounded: Number = 1 / 0

#[extern("alder:kernel", "$fiberMapWithOptions")]
pub fn map(values: Array[a], callback: fn(a) Task[b], options?: MapOptions) Task[Array[b]]

#[extern("alder:kernel", "$fiberForEachWithOptions")]
pub fn forEach(values: Array[a], callback: fn(a) Task[()], options?: MapOptions) Task[()]

#[extern("alder:kernel", "$fiberTryMapWithOptions")]
pub fn tryMap(values: Array[a], callback: fn(a) Task[Result[b, e]], options?: MapOptions) Task[Result[Array[b], e]]

#[extern("alder:kernel", "$fiberTryForEachWithOptions")]
pub fn tryForEach(values: Array[a], callback: fn(a) Task[Result[(), e]], options?: MapOptions) Task[Result[(), e]]

#[extern("alder:kernel", "$fiberFork")]
pub fn fork(task: Task[a]) Task[Fiber[a]]

#[extern("alder:kernel", "$fiberJoin")]
pub fn join(fiber: Fiber[a]) Task[a]

#[extern("alder:kernel", "$fiberInterrupt")]
pub fn interrupt(fiber: Fiber[a]) Task[()]

#[extern("alder:kernel", "$fiberAll")]
pub fn all(tasks: Array[Task[a]]) Task[Array[a]]

#[extern("alder:kernel", "$fiberRace")]
pub fn race(tasks: Array[Task[a]]) Task[a]

#[extern("alder:kernel", "$fiberScope")]
pub fn scope(task: Task[a]) Task[a]

#[extern("alder:kernel", "$fiberAddFinalizer")]
pub fn addFinalizer(finalizer: Task[()]) Task[()]

#[extern("alder:kernel", "$fiberUninterruptible")]
pub fn uninterruptible(task: Task[a]) Task[a]
