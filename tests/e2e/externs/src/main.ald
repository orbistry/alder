import ~/nested/operations

#[extern("./client.js", "boundedIdentity")]
fn bounded_identity(value: a) a where a: Show, a: Eq, a: Show

#[extern("./client.js", "boundedAsync", "abort")]
fn bounded_async(value: a) Task[a] where a: Show

#[extern("./client.js", "boundedIdentity")]
fn bounded_result(value: a) Result[a, [:rejected(String)]] where a: Show

fn generic_identity(value: a) a where a: Show + Eq {
    operations.bounded_identity(value)
}

#[extern("./client.js", "answer")]
fn answer() Task[Number]

#[extern("./client.js", "fulfilled")]
fn fulfilled(value: Result[Number, [:rejected(String)]]) Task[Result[Number, [:rejected(String)]]]

#[extern("./client.js", "pending", "abort")]
fn pending() Task[Number]

#[extern("./client.js", "abortCount")]
fn abortCount() Number

#[extern("./client.js", "throws")]
fn throws() Task[Number]

#[extern("./client.js", "rejects")]
fn rejects() Task[Number]

pub fn main() {
    assert(bounded_identity(42) == 42)
    let indirect = bounded_identity
    assert(indirect("hello") == "hello")
    assert(operations.bounded_identity(43) == 43)
    assert(generic_identity("generic") == "generic")
    assert(bounded_async(44).await == 44)
    assert(match bounded_result(45) { Ok(value) => value == 45, Err(_) => false })
    let args = Cli.args()
    if Array.length(args) > 0 {
        if args[0] == "throw" {
            assert(throws().await == 0)
        } else {
            assert(rejects().await == 0)
        }
    }
    assert(answer().await == 42)
    assert(operations.answer().await == 43)
    assert(match fulfilled(Ok(42)).await {
        Ok(value) => value == 42,
        Err(_) => false,
    })
    assert(match fulfilled(Err(:rejected("typed error"))).await {
        Ok(_) => false,
        Err(:rejected(message)) => message == "typed error",
    })
    let fiber = Fiber.fork(pending()).await
    Task.sleep(1).await
    Fiber.interrupt(fiber).await
    assert(abortCount() == 1)
}
