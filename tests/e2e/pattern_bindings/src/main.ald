import (
    cli,
    fiber,
    io,
    ref,
    task,
)
enum Payload { NumberValue(Number), TextValue(String) }
enum Alternative { First(Number), Second(Number) }

fn alternative_value(input: Alternative) Number {
    match input { First(value) | Second(value) if value > 0 => value, _ => 0 }
}

fn alternative_rest(input: Array[Number]) Array[Number] {
    match input { [0, ..values] | [1, ..values] => values, _ => [] }
}

fn alternative_alias(input: Alternative) Alternative {
    match input { First(_) as value | Second(_) as value => value }
}

fn alternative_closure(input: Alternative) {
    match input { First(value) | Second(value) => () -> value }
}

fn record_guard(events: Array[Number], value: Number) Bool {
    array.push(events, value)
    value == 2
}

async fn suspended_guard(events: Array[Number], value: Number) Bool {
    task.sleep(0).await
    record_guard(events, value)
}

async fn verify_alternative_guard_order() {
    let events = []
    let selected = match (1, 2) {
        (value, _) | (_, value) if record_guard(events, value) => value,
        _ => 0,
    }
    assert(selected == 2 && events == [1, 2])

    let first_events = []
    assert(match (2, 1) {
        (value, _) | (_, value) if record_guard(first_events, value) => value == 2,
        _ => false,
    })
    assert(first_events == [2])

    let failed_events = []
    assert(match (0, 1) {
        (value, _) | (_, value) if record_guard(failed_events, value) => false,
        _ => true,
    })
    assert(failed_events == [0, 1])

    let skipped_events = []
    assert(match (1, 2) {
        (0, value) | (_, value) if record_guard(skipped_events, value) => true,
        _ => false,
    })
    assert(skipped_events == [2])

    let async_events = []
    let async_selected = match (1, 2) {
        (value, _) | (_, value) if suspended_guard(async_events, value).await => value,
        _ => 0,
    }
    assert(async_selected == 2 && async_events == [1, 2])
}

#[extern("./probe.js", "runChecked")]
fn run_checked(task: Task[Number], cleanup: Array[Number], expected_count: Number) Task[Bool]

#[extern("./probe.js", "missingPayload")]
fn missing_payload() Number

fn parameter(input: Option[Number]) Number {
    match input { Some(value) => value, None => missing_payload() }
}

let top_value = parameter(if cli.args()[0] == "top" { None } else { Some(1) })

fn counted(counter: Array[Number]) Option[Number] {
    array.push(counter, 1)
    Some(42)
}

async fn async_parameter(input: Option[Number]) Number { parameter(input) }

fn verify_pin_scope() {
    let value = 7
    assert(match (1, 7) { (value, ^value) => value == 1, _ => false })
    assert(match (7, 1) { (^value, value) => value == 1, _ => false })
    assert(match { first: 1, second: 7 } {
        { first: value, second: ^value } => value == 1,
        _ => false,
    })
    assert(match Some((1, 7)) { Some((value, ^value)) => value == 1, _ => false })
    let expected = "text"
    assert(match (1, "text") { (value as expected, ^expected) => expected == 1, _ => false })
    let events = []
    assert(match pin_source(events) {
        (^pin_value(events, 1), ^pin_value(events, 2)) if false => false,
        _ => true,
    })
    assert(events == [0, 1, 2])
}

fn verify_unmatched_patterns_skip_pins() {
    let events = []
    let absent: Option[Number] = None
    assert(match absent { Some(^pin_value(events, 1)) => false, _ => true })
    let empty: Array[Number] = []
    assert(match empty { [^pin_value(events, 2)] => false, _ => true })
    assert(match (0, 2) { (1, ^pin_value(events, 3)) => false, _ => true })
    assert(match Payload::TextValue("other") {
        NumberValue(^pin_value(events, 4)) => false,
        _ => true,
    })
    assert(match { first: 0, second: 2 } {
        { first: 1, second: ^pin_value(events, 5) } => false,
        _ => true,
    })
    assert(events == [])
    assert(match (1, 2) {
        (^pin_value(events, 1), ^pin_value(events, 3)) => false,
        _ => true,
    })
    assert(events == [1, 3])
}

async fn verify_suspending_pin_short_circuit() {
    let events = []
    let absent: Option[Bool] = None
    assert(match absent { Some(^suspended_guard(events, 2).await) => false, _ => true })
    assert(events == [])
    assert(match Some(true) { Some(^suspended_guard(events, 2).await) => true, _ => false })
    assert(events == [2])
}

fn pin_source(events: Array[Number]) (Number, Number) {
    array.push(events, 0)
    (1, 2)
}

fn pin_value(events: Array[Number], value: Number) Number {
    array.push(events, value)
    value
}

fn verify_failed_checks_can_mutate_later_patterns() {
    let guarded = { flag: false }
    let guard_selected = match guarded {
        { flag: true } => 0,
        _ if {
            guarded.flag = true
            false
        } => 1,
        { flag: true } => 2,
        _ => 3,
    }
    assert(guard_selected == 2)
    let pinned = { flag: false }
    let pin_selected = match pinned {
        { flag: true } => 0,
        { flag: ^{
            pinned.flag = true
            true
            } } => 1,
        { flag: true } => 2,
        _ => 3,
    }
    assert(pin_selected == 2)
    let items = [0]
    let array_selected = match items {
        [_, _] => 0,
        _ if {
            array.push(items, 1)
            false
        } => 1,
        [_, _] => 2,
        _ => 3,
    }
    assert(array_selected == 2)
}

pub async fn main() {
    assert(top_value == 1)
    let args = cli.args()
    let mode = args[0]
    if mode == "let" {
        let absent: Option[Number] = None
        let value = parameter(absent)
        io.print(value)
    } else if mode == "parameter" {
        io.print(parameter(None))
    } else if mode == "lambda" {
        let read = (input: Option[Number]) -> parameter(input)
        io.print(read(None))
    } else if mode == "loop" {
        let values: Array[Option[Number]] = [None]
        for input in values { io.print(parameter(input)) }
    } else if mode == "enum" {
        let number = match Payload::TextValue("wrong") {
            NumberValue(number) => number,
            TextValue(_) => missing_payload(),
        }
        io.print(number)
    } else if mode == "array" {
        let values: Array[Number] = []
        let value = match values { [value] => value, _ => missing_payload() }
        io.print(value)
    } else if mode == "nested" {
        let absent: Option[Number] = None
        let value = match (absent, ()) {
            (Some(value) as whole, _) => value,
            _ => missing_payload(),
        }
        io.print(value)
    } else if mode == "async_parameter" {
        let work = async_parameter(None)
        assert(true)
        io.print(work.await)
    } else if mode == "async_body" {
        let absent: Option[Number] = None
        let work = async {
            let value = parameter(absent)
            value
        }
        io.print(work.await)
    } else {
        assert(alternative_value(Alternative::First(1)) == 1)
        assert(alternative_value(Alternative::Second(2)) == 2)
        assert(alternative_value(Alternative::Second(0)) == 0)
        assert(alternative_rest([0, 42]) == [42])
        assert(alternative_rest([1, 7]) == [7])
        assert(alternative_alias(Alternative::Second(3)) == Alternative::Second(3))
        let captured = alternative_closure(Alternative::Second(4))
        assert(captured() == 4)
        verify_pin_scope()
        verify_unmatched_patterns_skip_pins()
        verify_failed_checks_can_mutate_later_patterns()
        verify_suspending_pin_short_circuit().await
        verify_alternative_guard_order().await
        let unstarted = async_parameter(None)
        assert(ref.same(unstarted, unstarted))
        assert(parameter(Some(42)) == 42)
        let value = parameter(Some(7))
        assert(value == 7)
        let counter = []
        assert(match counted(counter) {
            Some(result) as whole => result == 42 && whole == Some(42) && array.length(counter) == 1,
            None => false,
        })
        assert(async_parameter(Some(3)).await == 3)
        let cleanup = []
        let broken = async {
            fiber.addFinalizer(async { array.push(cleanup, 99) }).await
            let absent: Option[Number] = None
            let number = parameter(absent)
            number
        }
        assert(run_checked(broken, cleanup, 1).await)
        assert(run_checked(broken, cleanup, 2).await)
    }
}
