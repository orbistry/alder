import (
    ~/joint_constraints,
    ~/rows,
    ~/rows.{OptionalName, Boxed},
)

fn rename(user: { r | name: String }, name: String) ({ r | name: String }) {
    { ..user, name }
}

fn choose(flag: Bool, user: { name?: String }) {
    if flag { { name: Some("present") } } else { user }
}

fn choose_loop(flag: Bool, user: { name?: String }) {
    loop {
        if flag { break { name: Some("present") } }
        break user
    }
}

fn choose_loop_reversed(flag: Bool, user: { name?: String }) {
    loop {
        if flag { break user }
        break loop { break { name: Some("present") } }
    }
}

fn counted(counter: Array[Number]) ({ value?: Number }) {
    array.push(counter, 1)
    { value: 42 }
}

fn destructure(record: { value?: Option[Number] }) Option[Option[Number]] {
    let { value } = record
    value
}

fn match_field(record: { value?: Number }) Option[Number] {
    match record { { value } => value }
}

enum Config { Config { value?: Option[Number] } }

fn config_field(config: Config) Option[Option[Number]] {
    match config { Config::Config { value } => value }
}

fn field_matches(record: { value?: Number }, expected: Option[Number]) Bool {
    match record {
        { value: ^expected } => true,
        _ => false,
    }
}

fn overlay_first() Result[Number, [:first]] { Err(:first) }
fn overlay_second() Result[Number, [:second]] { Err(:second) }

fn spread_source(record: { value: Number }, events: Array[Number]) {
    array.push(events, 1)
    record
}

fn spread_mutation(record: { value: Number }, events: Array[Number]) {
    array.push(events, 2)
    let target = record
    target.value = 99
    { marker: true }
}

fn spread_observation(record: { value: Number }, events: Array[Number]) Number {
    array.push(events, 3)
    record.value
}

pub fn main() {
    assert({ inner: { value: 42 } } == { inner: { value: 42 } })
    assert({ inner: { value: 42 } } != { inner: { value: 7 } })
    assert([{ inner: { value: Some(42) } }] == [{ inner: { value: Some(42) } }])
    assert([{ inner: { value: Some(42) } }] != [{ inner: { value: None } }])
    let joint_pair = ({ value: Err(:saved([])) }, "kept")
    let joint_result: Result[Number, [:saved(Array[Number])]] = joint_constraints.propagate(joint_pair, {})
    match joint_result {
        Err(:saved(values)) => array.push(values, 7),
        _ => { assert(false) },
    }
    assert(joint_constraints.shared == [42, 7])
    assert(joint_pair.1 == "kept")
    match joint_pair.0.value {
        Err(:saved(values)) => { assert(values == [42, 7]) },
        _ => { assert(false) },
    }
    let joint_override: Result[String, [:saved(Array[Number])]] = joint_constraints.propagate(
        ({ value: Ok("before") }, false),
        { value: Ok("after") },
    )
    match joint_override {
        Ok(value) => { assert(value == "after") },
        _ => { assert(false) },
    }
    assert(rows.tuple_first((20, false, "kept", 22), 3) == (20, false, "kept", 22))
    assert(rows.tuple_last((20, "independent", 7, 22), 4) == (20, "independent", 7, 22))
    assert(rows.tuple_sum((20, 22)) == 42)
    let tuple = (0, false, "untouched", 0)
    assert(rows.tuple_update(tuple) == 42)
    assert(tuple.0 == 20)
    assert(tuple.1 == false)
    assert(tuple.2 == "untouched")
    assert(tuple.3 == 22)
    let numbers = rows.associated_merges({ value: "old" }, { value: true }, { value: 42 })
    assert(numbers.0.value == 42 && numbers.1.value == 42)
    let strings = rows.associated_merges({ value: 42 }, { value: true }, { value: "last" })
    assert(strings.0.value == "last" && strings.1.value == "last")
    let number_arrays = rows.associated_merges({ items: [] }, {}, {})
    array.push(number_arrays.0.items, 42)
    assert(number_arrays.1.items[0] == 42)
    let string_arrays = rows.associated_merges({ items: [] }, {}, {})
    array.push(string_arrays.1.items, "fresh")
    assert(string_arrays.0.items[0] == "fresh")
    assert(array.length(number_arrays.1.items) == 1 && number_arrays.1.items[0] == 42)
    let spread_original = { value: 1 }
    let spread_events = []
    let spread_copy = {
        ..spread_source(spread_original, spread_events),
        ..spread_mutation(spread_original, spread_events),
        observed: spread_observation(spread_original, spread_events),
    }
    assert(spread_copy.value == 1)
    assert(spread_copy.observed == 99)
    assert(spread_original.value == 99)
    assert(spread_events == [1, 2, 3])
    let call_original = { value: 1 }
    let call_events = []
    let call_copy = rows.merge(
        spread_source(call_original, call_events),
        spread_mutation(call_original, call_events),
    )
    assert(call_copy.value == 99)
    assert(call_events == [1, 2])
    let block_original = { value: 1 }
    let block_events = []
    let block_copy = {
        ..spread_source(block_original, block_events),
        ..{
            let patch = spread_mutation(block_original, block_events)
            patch
        },
    }
    assert(block_copy.value == 1)
    assert(block_events == [1, 2])
    let overlay_empty_patch: { result?: Result[Number, [:second]] } = {}
    let overlay_fallback = rows.forward_optional({ result: overlay_first() }, overlay_empty_patch)
    assert(match overlay_fallback { Ok(_) => false, Err(:first) => true, Err(:second) => false })
    let overlay_override = rows.forward_optional({ result: overlay_first() }, { result: overlay_second() })
    assert(match overlay_override { Ok(_) => false, Err(:first) => false, Err(:second) => true })
    let overlay_forwarded = rows.forward_merged(
        { result: overlay_first() },
        { result: overlay_second() },
    )
    assert(match overlay_forwarded { Ok(value) => value, Err(:second) => 42 } == 42)
    let overlay_captured = [1]
    let overlay_operation = rows.merger({ values: overlay_captured })
    let overlay_result = overlay_operation({ marker: true })
    array.push(overlay_result.values, 2)
    assert(array.length(overlay_captured) == 2)
    assert(overlay_captured[1] == 2)
    let overlay_absent: { value?: Option[Number] } = {}
    let overlay_nested: { value?: Option[Number] } = { value: Some(None) }
    assert(rows.merge(overlay_absent, { marker: true }).value == option.none())
    assert(rows.merge(overlay_nested, { marker: true }).value == option.some(option.none()))
    assert(rows.read_merged_optional({ marker: "overwritten" }) == option.none())
    assert(rows.read_merged_optional({ value: Some(None) }) == option.some(option.none()))
    assert(rows.read_merged_optional({ value: option.some(42) }) == option.some(option.some(42)))
    let outcome = rows.preserve_outcome(rows.failure())
    let error_value = match outcome {
        Ok(value) => value,
        Err(:missing(message)) => string.length(message),
        Err(:timeout) => 42,
    }
    assert(error_value == 42)
    let first = rows.rename({ name: "old", score: 42 }, "new")
    let second = rows.rename({ name: "old", enabled: true }, "other")
    assert(first.score == 42)
    assert(first.name == "new")
    assert(second.enabled)
    assert(second.name == "other")
    assert(rows.sum({ x: 20, y: 22, extra: true }) == 42)
    let pair = rows.preserve_two({ x: 1, left: "left" }, { y: 2, right: true })
    assert(pair.0.x == 2)
    assert(pair.0.left == "left")
    assert(pair.1.y == 3)
    assert(pair.1.right)
    let optional: OptionalName = {}
    let merged = rows.merge({ x: 20 }, { y: 22 })
    assert(merged.x + merged.y == 42)
    assert(rows.merge({ value: 42 }, { value: "right" }).value == "right")
    assert(rows.fallback({}) == 42)
    assert(rows.fallback({ extra: true }) == 42)
    assert(rows.fallback({ value: 7 }) == 7)
    let absent_spread: { value?: Number } = {}
    let present_spread: { value?: Number } = { value: 7 }
    let fallback = { value: 42, ..absent_spread }
    let overridden = { value: 42, ..present_spread }
    assert(fallback.value == None)
    assert(overridden.value == Some(7))
    let still_absent = { ..absent_spread, ..absent_spread }
    let retained = { ..present_spread, ..absent_spread }
    assert(still_absent.value == option.none())
    assert(retained.value == None)
    let replaced = { value: 42, ..{ value: "text" } }
    assert(replaced.value == "text")
    let maybe_text: { value?: String } = {}
    let final_override = { ..{ value: 42 }, ..maybe_text, value: true }
    assert(final_override.value)
    let number: Boxed[Number] = rows.boxed(42)
    let label: Boxed[String] = rows.boxed("hello")
    assert(number.value == 42)
    assert(label.value == "hello")
    assert(rows.choose(false, optional).name == option.none())
    assert(rows.choose(true, optional).name == option.some("present"))
    let user = rename({ name: "old", score: 42 }, "new")
    assert(user.score == 42)
    assert(user.name == "new")
    assert(choose(false, {}).name == option.none())
    assert(choose(true, {}).name == option.some("present"))
    assert(choose_loop(false, {}).name == option.none())
    assert(choose_loop(true, {}).name == option.some("present"))
    assert(choose_loop_reversed(true, {}).name == option.none())
    assert(choose_loop_reversed(false, {}).name == option.some("present"))
    let absent: { value?: Option[Number] } = {}
    let present: { value?: Option[Number] } = { value: Some(None) }
    assert(absent.value == option.none())
    assert(present.value == option.some(option.none()))
    assert(destructure({}) == option.none())
    assert(destructure({ value: Some(None) }) == option.some(option.none()))
    assert(destructure({ value: option.some(42) }) == option.some(option.some(42)))
    assert(match_field({}) == option.none())
    assert(match_field({ value: 42 }) == option.some(42))
    assert(field_matches({}, option.none()))
    assert(field_matches({ value: 42 }, option.some(42)))
    assert(!field_matches({}, option.some(42)))
    assert(config_field(Config::Config {}) == option.none())
    assert(config_field(Config::Config { value: Some(None) }) == option.some(option.none()))
    let assigned: { value?: Option[Number] } = {}
    assert(assigned.value == option.none())
    assigned.value = option.none()
    assert(assigned.value == None)
    assigned.value = Some(None)
    assert(assigned.value == option.some(option.none()))
    assigned.value = Some(Some(42))
    assert(assigned.value == option.some(option.some(42)))
    let nested: { child: { value?: Number } } = { child: {} }
    nested.child.value = Some(42)
    assert(nested.child.value == option.some(42))
    let counter = []
    assert(counted(counter).value == option.some(42))
    assert(array.length(counter) == 1)
}
