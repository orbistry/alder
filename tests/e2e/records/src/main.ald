import ~/rows
import ~/rows.{ OptionalName, Boxed }

fn rename(user: { r | name: String }, name: String) ({ r | name: String }) {
    { ..user, name }
}

fn choose(flag: Bool, user: { name?: String }) {
    if flag { { name: "present" } } else { user }
}

fn choose_loop(flag: Bool, user: { name?: String }) {
    loop {
        if flag { break { name: "present" } }
        break user
    }
}

fn choose_loop_reversed(flag: Bool, user: { name?: String }) {
    loop {
        if flag { break user }
        break loop { break { name: "present" } }
    }
}

fn counted(counter: Array[Number]) ({ value?: Number }) {
    Array.push(counter, 1)
    { value: 42 }
}

fn destructure(record: { value?: Option[Number] }) Option[Option[Number]] {
    let { value } = record
    value
}

fn match_field(record: { value?: Number }) Option[Number] {
    match record { { value } => value }
}

enum Config { Config { value?: Option[Number] } }

fn config_field(config: Config) Option[Option[Number]] {
    match config { Config::Config { value } => value }
}

fn field_matches(record: { value?: Number }, expected: Option[Number]) Bool {
    match record {
        { value: ^expected } => true,
        _ => false,
    }
}

pub fn main() {
    let outcome = rows.preserve_outcome(rows.failure())
    let error_value = match outcome {
        Ok(value) => value,
        Err(:missing(message)) => String.length(message),
        Err(:timeout) => 42,
    }
    assert(error_value == 42)
    let first = rows.rename({ name: "old", score: 42 }, "new")
    let second = rows.rename({ name: "old", enabled: true }, "other")
    assert(first.score == 42)
    assert(first.name == "new")
    assert(second.enabled)
    assert(second.name == "other")
    assert(rows.sum({ x: 20, y: 22, extra: true }) == 42)
    let pair = rows.preserve_two({ x: 1, left: "left" }, { y: 2, right: true })
    assert(pair.0.x == 2)
    assert(pair.0.left == "left")
    assert(pair.1.y == 3)
    assert(pair.1.right)
    let optional: OptionalName = {}
    let number: Boxed[Number] = rows.boxed(42)
    let label: Boxed[String] = rows.boxed("hello")
    assert(number.value == 42)
    assert(label.value == "hello")
    assert(rows.choose(false, optional).name == Option.none())
    assert(rows.choose(true, optional).name == Option.some("present"))
    let user = rename({ name: "old", score: 42 }, "new")
    assert(user.score == 42)
    assert(user.name == "new")
    assert(choose(false, {}).name == Option.none())
    assert(choose(true, {}).name == Option.some("present"))
    assert(choose_loop(false, {}).name == Option.none())
    assert(choose_loop(true, {}).name == Option.some("present"))
    assert(choose_loop_reversed(true, {}).name == Option.none())
    assert(choose_loop_reversed(false, {}).name == Option.some("present"))
    let absent: { value?: Option[Number] } = {}
    let present: { value?: Option[Number] } = { value: Option.none() }
    assert(absent.value == Option.none())
    assert(present.value == Option.some(Option.none()))
    assert(destructure({}) == Option.none())
    assert(destructure({ value: Option.none() }) == Option.some(Option.none()))
    assert(destructure({ value: Option.some(42) }) == Option.some(Option.some(42)))
    assert(match_field({}) == Option.none())
    assert(match_field({ value: 42 }) == Option.some(42))
    assert(field_matches({}, Option.none()))
    assert(field_matches({ value: 42 }, Option.some(42)))
    assert(!field_matches({}, Option.some(42)))
    assert(config_field(Config::Config {}) == Option.none())
    assert(config_field(Config::Config { value: Option.none() }) == Option.some(Option.none()))
    let mut assigned: { value?: Option[Number] } = {}
    assert(assigned.value == Option.none())
    assigned.value = Option.none()
    assert(assigned.value == Option.some(Option.none()))
    assigned.value = Option.some(42)
    assert(assigned.value == Option.some(Option.some(42)))
    let mut nested: { child: { value?: Number } } = { child: {} }
    nested.child.value = 42
    assert(nested.child.value == Option.some(42))
    let counter = []
    assert(counted(counter).value == Option.some(42))
    assert(Array.length(counter) == 1)
}
