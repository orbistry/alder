pub fn main() {}

trait Display[a] {
    fn display(value: a) -> String

    fn render(value: a) -> String {
        display(value)
    }
}

impl Display[Number] {
    fn display(value: Number) -> String {
        "number"
    }
}

fn describe(value: a) -> String where a: Display {
    display(value)
}

fn recursive_left(value: a) -> String where a: Display {
    recursive_right(value)
}

fn recursive_right(value: a) -> String where a: Display {
    if true { display(value) } else { recursive_left(value) }
}

fn generic_equal(left: a, right: a) -> Bool where a: Eq {
    left == right
}

fn generic_add(left: a, right: a) -> a where a: Num {
    left + right
}

fn generic_sub(left: a, right: a) -> a where a: Num {
    left - right
}

fn generic_negate(value: a) -> a where a: Num {
    -value
}

fn generic_greater(left: a, right: a) -> Bool where a: Ord {
    left > right
}

fn ordered_equal(left: a, right: a) -> Bool where a: Ord {
    left == right
}

trait Same[a] {
    fn same(left: a, right: a) -> Bool
}

trait Ranked[a] where a: Same {
    fn ranked(left: a, right: a) -> Bool
}

impl Same[Number] {
    fn same(left: Number, right: Number) -> Bool { left == right }
}

impl Ranked[Number] {
    fn ranked(left: Number, right: Number) -> Bool { left < right }
}

fn ranked_same(left: a, right: a) -> Bool where a: Ranked {
    same(left, right)
}

enum Maybe[a] {
    None,
    Some(a),
}

#[derive(Show, Ord, Hash, Json)]
enum Phase {
    Alpha,
    Beta,
}

trait Mapper[f] {
    fn map(value: f[a], transform: fn(a) -> b) -> f[b]
}

impl Mapper[Maybe] {
    fn map(value: Maybe[a], transform: fn(a) -> b) -> Maybe[b] {
        match value {
            Maybe::None => Maybe::None,
            Maybe::Some(item) => Maybe::Some(transform(item)),
        }
    }
}

impl Mapper[Result[_, e]] {
    fn map(value: Result[a, e], transform: fn(a) -> b) -> Result[b, e] {
        Result.map(value, transform)
    }
}

fn mapped_result() -> Result[Number, String] {
    let initial: Result[Number, String] = Result.ok(41)
    map(initial, fn(value) { value + 1 })
}

test "arithmetic works" {
    assert 1 + 1 == 2
    assert generic_equal(1, 1)
    assert generic_add(20, 22) == 42
    assert generic_sub(44, 2) == 42
    assert generic_negate(42) == -42
    assert generic_greater(2, 1)
    assert ordered_equal(1, 1)
    assert ranked_same(42, 42)
}

test "trait dictionaries dispatch" {
    assert describe(1) == "number"
    assert render(1) == "number"
    assert recursive_left(1) == "number"
}

test "higher-kinded trait dictionaries dispatch" {
    assert Maybe::Some(1) == Maybe::Some(1)
    let mapped = map(Maybe::Some(41), fn(value) { value + 1 })
    assert match mapped {
        Maybe::Some(value) => value == 42,
        Maybe::None => false,
    }
    let result = mapped_result()?
    assert result == 42
}

test "derived dictionaries execute" {
    assert Phase::Alpha == Phase::Alpha
    assert Phase::Alpha < Phase::Beta
    assert show(Phase::Alpha) == "Alpha"
    assert hash(Phase::Alpha) == hash(Phase::Alpha)
    let decoded = decode(encode(Phase::Beta))?
    assert decoded == Phase::Beta
    let expected = Phase::Alpha
    assert match Phase::Alpha {
        ^expected => true,
        _ => false,
    }
}

tests {
    test "arrays are mutable values" {
        let values = [1]
        assert values[0] == 1
    }
}
