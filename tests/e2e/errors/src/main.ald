import ~/rows

fn storage() Result[Number, [:storage(String)]] {
    Err(:storage("disk"))
}

fn decode() Result[Number, [:invalid(String)]] {
    Err(:invalid("number"))
}

error AccessFailure {
    :forbidden
}

fn authorize() Result[Number, AccessFailure] {
    Err(:forbidden)
}

error ClosedFailure {
    :invalid(String),
    :missing
}

fn closed_failure(which: Number) Result[Number, ClosedFailure] {
    if which == 0 {
        return Err(:invalid("closed"))
    }
    Err(:missing)
}

fn closed_match(which: Number) Bool {
    match closed_failure(which) {
        Ok(value) => false,
        Err(:invalid(message)) => message == "closed",
        Err(:missing) => true,
    }
}

fn load(which: Number) Result[Number] {
    if which == 0 {
        let value = storage()?
        Ok(value)
    } else if which == 1 {
        let value = decode()?
        Ok(value)
    } else {
        let value = authorize()?
        Ok(value)
    }
}

fn is_expected(which: Number) Bool {
    match load(which) {
        Ok(value) => false,
        Err(:storage(message)) => message == "disk",
        Err(:invalid(message)) => message == "number",
        Err(:forbidden) => true,
        Err(_) => false,
    }
}

pub fn main() Result[()] {
    assert(is_expected(0))
    assert(is_expected(1))
    assert(is_expected(2))
    assert(closed_match(0))
    assert(closed_match(1))
    assert(exact_union(0) == 1)
    assert(exact_union(1) == 2)
    assert(exact_union(2) == 42)
    assert(recursive_union(4) == 1)
    assert(recursive_union(3) == 2)
    Ok(())
}

fn stored() Result[Number, [:storage(String)]] { Ok(20) }

fn decoded() Result[Number, [:invalid(String)]] { Ok(22) }

fn exact_union(which: Number) Number {
    let left = if which == 0 { storage() } else { stored() }
    let right = if which == 1 { decode() } else { decoded() }
    match rows.combine(left, right) {
        Ok(value) => value,
        Err(:storage(message)) => 1,
        Err(:invalid(message)) => 2,
    }
}

fn recursive_union(n: Number) Number {
    match rows.recursive(n) {
        Ok(value) => value,
        Err(:first) => 1,
        Err(:second) => 2,
    }
}
