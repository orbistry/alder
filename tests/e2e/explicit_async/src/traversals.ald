import (
    fiber,
    task,
)
async fn classify(value: Number) Result[Number, [:bad]] {
    if value == 2 { Err(:bad) } else { Ok(value * 2) }
}

async fn try_visit(value: Number, visits: Array[Number]) Result[(), [:bad]] {
    let result = classify(value).await?
    array.push(visits, result)
    Ok(())
}

async fn piped_try_map() Result[Array[Number], [:bad]] {
    let values = [1, 3] |> fiber.tryMap(classify).await?
    Ok(values)
}

pub async fn run() {
    let unlimited: fiber::MapOptions = { concurrency: fiber.unbounded }
    let started = 0
    let all_started = false
    let work = fiber.map([1, 2, 3], value -> async {
        started += 1
        while !all_started { task.sleep(0).await }
        value * 2
        }, unlimited)
    assert started == 0
    let running = fiber.fork(work).await
    while started != 3 { task.sleep(0).await }
    all_started = true
    assert fiber.join(running).await == [2, 4, 6]
    let unlimited_visits: Array[Number] = []
    fiber.forEach([1, 3], value -> async {
        array.push(unlimited_visits, value)
        }, unlimited).await
    assert array.length(unlimited_visits) == 2
    assert match fiber.tryMap([1, 3], classify, unlimited).await {
        Ok(values) => values == [2, 6],
        _ => false,
    }
    assert match fiber.tryForEach([1, 3], value -> try_visit(value, unlimited_visits), unlimited).await {
        Ok(()) => true,
        _ => false,
    }
    assert array.length(unlimited_visits) == 4

    let calls = 0
    let active = 0
    let peak = 0
    let cleaned = 0
    let input = [1, 2, 3]
    let options: fiber::MapOptions = { concurrency: 2 }
    let mapped = fiber.map(input, value -> async {
        calls += 1
        active += 1
        if active > peak { peak = active }
        fiber.addFinalizer(async {
            task.sleep(0).await
            active -= 1
            cleaned += 1
        }).await
        task.sleep(0).await
        value * 2
        }, options)
    assert calls == 0
    assert mapped.await == [2, 4, 6]
    assert calls == 3
    assert peak == 2
    assert active == 0
    assert cleaned == 3
    input[0] = 10
    assert mapped.await == [20, 4, 6]
    assert cleaned == 6

    let visits: Array[Number] = []
    let each = fiber.forEach([1, 2, 3], value -> async {
        array.push(visits, value)
        task.sleep(0).await
        array.push(visits, value * 10)
    })
    assert visits == []
    each.await
    assert visits == [1, 10, 2, 20, 3, 30]
    assert ([1, 2] |> fiber.map(value -> async { value + 1 }).await) == [2, 3]
    assert fiber.map([1], value -> async { value }, None).await == [1]
    assert fiber.map([1], value -> async { value }, {}).await == [1]

    let settled = fiber.map([1, 2, 3], classify, { concurrency: 2 }).await
    assert match settled[0] { Ok(2) => true, _ => false }
    assert match settled[1] { Err(:bad) => true, _ => false }
    assert match settled[2] { Ok(6) => true, _ => false }
    let attempted: Array[Number] = []
    let failed = fiber.tryMap([1, 2, 3], value -> async {
        array.push(attempted, value)
        classify(value).await
    }).await
    assert match failed { Err(:bad) => true, _ => false }
    assert attempted == [1, 2]
    let successful = fiber.tryMap([1, 3], classify, { concurrency: 2 }).await
    assert match successful { Ok(values) => values == [2, 6], _ => false }
    assert match piped_try_map().await { Ok(values) => values == [2, 6], _ => false }
    let successful_visits: Array[Number] = []
    let failed_each = fiber.tryForEach([1, 2, 3], value -> try_visit(value, successful_visits)).await
    assert match failed_each { Err(:bad) => true, _ => false }
    assert successful_visits == [2]
    let passed_each = fiber.tryForEach([1, 3], value -> try_visit(value, successful_visits), {}).await
    assert match passed_each { Ok(()) => true, _ => false }
    assert successful_visits == [2, 2, 6]
}

pub async fn interruption_waits_for_cleanup() {
    for mode in [0, 1, 2, 3] {
        let started = 0
        let ready = 0
        let cleanup_started = 0
        let cleaned = 0
        let release = false
        let interrupted = false
        let callback = (value: Number) Task[()] -> async {
            started += 1
            fiber.addFinalizer(async {
                cleanup_started += 1
                while !release { task.sleep(0).await }
                cleaned += 1
            }).await
            ready += 1
            while true { task.sleep(0).await }
        }
        let typed_callback = (value: Number) Task[Result[(), [:bad]]] -> async {
            callback(value).await
            Ok(())
        }
        let work = async {
            if mode == 0 {
                let result = fiber.map([1, 2, 3, 4], callback, { concurrency: 2 }).await
            } else if mode == 1 {
                fiber.forEach([1, 2, 3, 4], callback, { concurrency: 2 }).await
            } else if mode == 2 {
                let result = fiber.tryMap([1, 2, 3, 4], typed_callback, { concurrency: 2 }).await
            } else {
                let result = fiber.tryForEach([1, 2, 3, 4], typed_callback, { concurrency: 2 }).await
            }
        }
        let child = fiber.fork(work).await
        while ready != 2 { task.sleep(0).await }
        let interrupt = fiber.fork(async {
            fiber.interrupt(child).await
            interrupted = true
        }).await
        while cleanup_started != 2 { task.sleep(0).await }
        assert !interrupted
        assert cleaned == 0
        assert started == 2
        release = true
        fiber.join(interrupt).await
        assert interrupted
        assert cleaned == 2
        assert started == 2
    }
}

pub async fn typed_failure_waits_for_sibling_cleanup() {
    for mode in [0, 1] {
        let started = 0
        let ready = 0
        let fail = false
        let cleanup_started = 0
        let cleaned = 0
        let release = false
        let completed = false
        let callback = (value: Number) Task[Result[(), [:later]]] -> async {
            started += 1
            fiber.addFinalizer(async {
                cleanup_started += 1
                while !release { task.sleep(0).await }
                cleaned += 1
            }).await
            ready += 1
            while !fail { task.sleep(0).await }
            if value == 1 { Err(:later) } else { while true { task.sleep(0).await } }
        }
        let traversal = fiber.fork(async {
            let selected_later = if mode == 0 {
                match fiber.tryMap([0, 1, 2, 3], callback, { concurrency: 2 }).await {
                    Err(:later) => true,
                    _ => false,
                }
            } else {
                match fiber.tryForEach([0, 1, 2, 3], callback, { concurrency: 2 }).await {
                    Err(:later) => true,
                    _ => false,
                }
            }
            assert selected_later
            completed = true
        }).await
        while ready != 2 { task.sleep(0).await }
        fail = true
        while cleanup_started != 2 { task.sleep(0).await }
        assert !completed
        assert cleaned == 0
        assert started == 2
        release = true
        fiber.join(traversal).await
        assert completed
        assert cleaned == 2
        assert started == 2
    }
}
