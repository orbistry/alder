pub fn encode_value(value: a) String where a: Json { Json.encode(value) }

pub fn describe(value: a) String where a: Show, a: Eq, a: Show {
    if value == value { show(value) } else { "not equal" }
}

pub fn decode_value(text: String) Result[a, [:invalid_json(String)]] where a: Json {
    Json.decode(text)
}
