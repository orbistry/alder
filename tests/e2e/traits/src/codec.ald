import json
pub fn encode_value(value: a) String where a: Json { json.encode(value) }

pub fn capture_order(left: a) fn(a) (Ordering, Bool) where a: Ord {
    let ordering = compare
    let equality = (right: a) -> left == right
    right -> (ordering(left, right), equality(right))
}

pub fn hash_equal(left: a, right: a) Bool where a: Hash {
    left == right && hash(left) == hash(right)
}

pub fn describe(value: a) String where a: Show, a: Eq, a: Show {
    if value == value { show(value) } else { "not equal" }
}

pub fn decode_value(text: String) Result[a, [:invalid_json(String)]] where a: Json {
    json.decode(text)
}
