#[derive(Show, Ord, Hash, Json)]
enum Status {
    Ready,
    Failed(String),
    Meta { code: Number, note: String },
}

#[derive(Json)]
enum Config {
    Config { name: String, note?: String },
}

#[derive(Ord)]
enum OrderProbe {
    Value { zed: Number, alpha: Number },
}

#[derive(Hash)]
enum FirstHashProbe {
    Value { payload: Number },
}

#[derive(Hash)]
enum SecondHashProbe {
    Value { payload: Number },
}

enum Secret { Secret }

impl Show[Secret] {
    fn show(value: Secret) -> String { "redacted" }
}

impl Hash[Secret] {
    fn hash(value: Secret) -> BigInt { 23n }
}

impl Json[Secret] {
    fn encode(value: Secret) -> String { "\"secret\"" }
    fn decode(value: String) -> Result[Secret, String] { Result.ok(Secret::Secret) }
}

#[derive(Show)]
enum SecretBox { SecretBox(Secret) }

#[derive(Show, Hash, Json)]
enum NestedSecretBox { NestedSecretBox(Array[Option[Secret]]) }

enum Reverse { Low, High }

impl Ord[Reverse] {
    fn lt(left: Reverse, right: Reverse) -> Bool {
        left == Reverse::High && right == Reverse::Low
    }
    fn lte(left: Reverse, right: Reverse) -> Bool { left == right || lt(left, right) }
    fn gt(left: Reverse, right: Reverse) -> Bool { lt(right, left) }
    fn gte(left: Reverse, right: Reverse) -> Bool { left == right || gt(left, right) }
}

#[derive(Ord)]
enum ReverseBox { ReverseBox(Reverse) }

enum HashSecret { First, Second }

impl Hash[HashSecret] {
    fn hash(value: HashSecret) -> BigInt { 7n }
}

#[derive(Hash)]
enum HashSecretBox { HashSecretBox(HashSecret) }

enum JsonSecret { JsonSecret }

impl Json[JsonSecret] {
    fn encode(value: JsonSecret) -> String { "\"secret\"" }
    fn decode(value: String) -> Result[JsonSecret, String] { Result.ok(JsonSecret::JsonSecret) }
}

#[derive(Json)]
enum JsonSecretBox { JsonSecretBox(JsonSecret) }

trait Describe[a] {
    fn describe(value: a) -> String
}

impl Describe[Number] {
    fn describe(value: Number) -> String { "number" }
}

impl Describe[String] {
    fn describe(value: String) -> String { value }
}

impl Describe[Array[a]] where a: Describe {
    fn describe(value: Array[a]) -> String { "array" }
}

fn describe_generic(value: a) -> String where a: Describe {
    describe(value)
}

pub fn main() {
    assert(describe_generic(1) == "number")
    assert(describe_generic("text") == "text")
    assert(describe_generic([1, 2]) == "array")

    assert(show(Status::Failed("oops")) == "Failed(\"oops\")")
    assert(show(Status::Meta { code: 7, note: "same" }) == "Meta { code: 7, note: \"same\" }")
    assert(Status::Ready < Status::Failed("later"))
    assert(OrderProbe::Value { zed: 0, alpha: 9 } < OrderProbe::Value { zed: 1, alpha: 0 })
    assert(hash(Status::Meta { code: 7, note: "same" }) == hash(Status::Meta { code: 7, note: "same" }))
    assert(hash(Status::Meta { code: 7, note: "same" }) != hash(Status::Meta { code: 8, note: "same" }))
    assert(hash(FirstHashProbe::Value { payload: 1 }) != hash(SecondHashProbe::Value { payload: 1 }))
    assert(show(SecretBox::SecretBox(Secret::Secret)) == "SecretBox(redacted)")
    let nested_secret = NestedSecretBox::NestedSecretBox([Option.some(Secret::Secret), Option.none()])
    assert(show(nested_secret) == "NestedSecretBox([Some(redacted), None])")
    assert(encode(nested_secret) == "{\"tag\":\"NestedSecretBox\",\"fields\":[[\"secret\",null]]}")
    let decoded_nested_secret: Result[NestedSecretBox, String] = decode(encode(nested_secret))
    assert(decoded_nested_secret == Result.ok(nested_secret))
    assert(hash(nested_secret) == hash(NestedSecretBox::NestedSecretBox([Option.some(Secret::Secret), Option.none()])))
    assert(ReverseBox::ReverseBox(Reverse::High) < ReverseBox::ReverseBox(Reverse::Low))
    assert(hash(HashSecretBox::HashSecretBox(HashSecret::First)) == hash(HashSecretBox::HashSecretBox(HashSecret::Second)))

    let secret_json = encode(JsonSecretBox::JsonSecretBox(JsonSecret::JsonSecret))
    assert(secret_json == "{\"tag\":\"JsonSecretBox\",\"fields\":[\"secret\"]}")
    let decoded_secret: Result[JsonSecretBox, String] = decode(secret_json)
    assert(decoded_secret == Result.ok(JsonSecretBox::JsonSecretBox(JsonSecret::JsonSecret)))

    let encoded = encode(Status::Meta { code: 42, note: "answer" })
    let decoded: Result[Status, String] = decode(encoded)
    assert(decoded == Result.ok(Status::Meta { code: 42, note: "answer" }))

    let config = Config::Config { name: "alder" }
    let config_json = encode(config)
    assert(config_json == "{\"tag\":\"Config\",\"value\":{\"name\":\"alder\"}}")
    let decoded_config: Result[Config, String] = decode(config_json)
    assert(decoded_config == Result.ok(config))
    let extra_config_field: Result[Config, String] = decode("{\"tag\":\"Config\",\"value\":{\"name\":\"alder\",\"extra\":true}}")
    assert(extra_config_field == Result.err("$.value.extra: unexpected field"))
    let extra_config_envelope: Result[Config, String] = decode("{\"tag\":\"Config\",\"value\":{\"name\":\"alder\"},\"extra\":true}")
    assert(extra_config_envelope == Result.err("$: expected only `tag` and `value`"))

    let mapped: Option[Number] = map(Option.some(1), fn(value) { value + 1 })
    assert(mapped == Option.some(2))

    let mapped_array: Array[Number] = map([1, 2], fn(value) { value + 1 })
    assert(mapped_array == [2, 3])

    let result: Result[Number, String] = Result.ok(1)
    let mapped_result: Result[Number, String] = map(result, fn(value) { value + 1 })
    assert(mapped_result == Result.ok(2))
}
