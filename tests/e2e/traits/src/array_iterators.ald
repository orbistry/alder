import array.{ArrayIterator}

pub fn advance(iterator: i) Option[Number] where i: Iterator, i.Item == Number {
    next(iterator)
}

pub fn run() {
    let values = [7, 8]
    let first = array.iter(values)
    let alias = first
    let second = array.iter(values)
    let step: fn(ArrayIterator[Number]) Option[Number] = next
    assert(step(first) == Some(7))
    assert(advance(alias) == Some(8))
    assert(next(first) == None)
    assert(next(first) == None)
    assert(next(second) == Some(7))
    assert(next(second) == Some(8))
    assert(values == [7, 8])

    let live = array.iter(values)
    assert(next(live) == Some(7))
    values[1] = 20
    array.push(values, 30)
    assert(next(live) == Some(20))
    assert(next(live) == Some(30))
    assert(next(live) == None)
    array.push(values, 40)
    assert(next(live) == None)

    let units = array.iter([()])
    assert(next(units) == Some(()))
    assert(next(units) == None)
    let options: Array[Option[Number]] = [None, Some(42)]
    let optional = array.iter(options)
    match next(optional) {
        Some(None) => {}
        _ => { assert(false) }
    }
    match next(optional) {
        Some(Some(value)) => { assert(value == 42) }
        _ => { assert(false) }
    }
    assert(next(optional) == None)

    let records = [{ value: 1 }]
    let shared = array.iter(records)
    match next(shared) {
        Some(record) => { record.value = 42 }
        None => { assert(false) }
    }
    assert(records[0].value == 42)
}
