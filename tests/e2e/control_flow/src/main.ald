import ~/tags
import ~/call_order
import ~/assignments
import ~/methods
import ~/pins
import ~/pattern_capture

fn choose(flag: Bool) Number {
    if flag { return 42 } else { return 43 }
}

fn mixed(flag: Bool) Number {
    if flag { return 42 } else { 43 }
}

fn matched(flag: Bool) Number {
    match flag {
        true => { return 42 },
        false => { return 43 },
    }
}

async fn awaited(flag: Bool) Number {
    Task.sleep(1).await
    if flag { return 42 } else { return 43 }
}

fn loop_tail_return(flag: Bool) Number {
    let count = 0
    while count < 1 {
        count += 1
        if flag { return 42 } else { return 43 }
    }
    0
}

fn loop_tail_effects() Number {
    let values = []
    for value in [1, 2] {
        Array.push(values, value)
    }
    Array.length(values)
}

fn break_payload_effects() Number {
    let values = []
    while true {
        break Array.push(values, 42)
    }
    Array.length(values)
}

fn nested_loop_values(flag: Bool) Number {
    loop {
        let inner: String = loop { break "inner" }
        assert(inner == "inner")
        while true { break }
        for value in [1] { break }
        if flag { return 41 }
        break 42
    }
}

async fn awaited_loop_value() Number {
    loop {
        Task.sleep(1).await
        break 42
    }
}

fn loop_payload_once() Number {
    let values = []
    let result: Number = loop {
        break {
            Array.push(values, 42)
            Array.length(values)
        }
    }
    assert(result == 1)
    Array.length(values)
}

fn while_condition_exits_enclosing_loop() Number {
    loop {
        while { break 42 } {}
        break 0
    }
}

fn array_operand_exit() Number {
    loop { [{ break 42 }, { break "unreachable" }] }
}

fn annotated_array_operand_exit() Number {
    loop {
        let values: Array[Number] = [{ break 42 }, { break "unreachable" }]
    }
}

fn tuple_operand_exit() Number {
    loop { ({ break 42 }, { break "unreachable" }) }
}

fn tag_operand_exit() Number {
    loop { Err(:pair({ break 42 }, { break "unreachable" })) }
}

fn template_operand_exit() Number {
    loop { `${{ break 42 }}${{ break "unreachable" }}` }
}

fn unused_tag(parts: Array[String], a: Number, b: Number) String { "unused" }

fn tagged_template_operand_exit() Number {
    loop { unused_tag`${{ break 42 }}${{ break "unreachable" }}` }
}

fn index_operand_exit() Number {
    loop { ({ break 42 })[{ break "unreachable" }] }
}

fn assignment_operand_exit() Number {
    let values = [[0]]
    loop {
        values[{ break 42 }][{ break "unreachable index" }] = { break "unreachable value" }
    }
}

fn record_operand_exit() Number {
    loop { let ignored = { a: { break 42 }, b: { break "unreachable" } } }
}

fn annotated_record_operand_exit() Number {
    loop {
        let ignored: { a: Number, b: Number } = {
            a: { break 42 }, b: { break "unreachable" }
        }
    }
}

async fn while_condition_continues_enclosing_loop() Number {
    let checks = 0
    let rounds = 0
    loop {
        rounds += 1
        while {
            Task.sleep(0).await
            checks += 1
            if checks == 1 { continue }
            false
        } {}
        break rounds
    }
}

fn short_circuit_loop() Number {
    loop {
        let skipped = false && { break "unreachable" }
        let also_skipped = true || { break "unreachable" }
        let reached = true && { break 42 }
    }
}

fn guarded_loop(flag: Bool) Number {
    loop {
        match flag {
            true if false => { break "unreachable" },
            _ => { break 42 },
        }
    }
}

fn observe(events: Array[Number], value: Number) Number {
    Array.push(events, value)
    value
}

fn pair(left: Number, right: Number) (Number, Number) {
    (left, right)
}

fn operand_return(events: Array[Number]) Number {
    let ignored = [observe(events, 1), { return 42 }, observe(events, 3)]
    0
}

fn render_tag(parts: Array[String], left: Number, right: Number) String {
    assert(parts == ["before", "between", "after"])
    `${left}:${right}`
}

fn identity_tag(parts: Array[String], value: a) a { value }

fn tag_segments(parts: Array[String], left: Number, right: Number) Array[String] { parts }

fn show_tag(parts: Array[String], value: a) String where a: Show { show(value) }

async fn async_tag(parts: Array[String], value: Number) Number {
    Task.sleep(1).await
    value
}

fn template_order() {
    let events = []
    let rendered = `${observe(events, 1)}:${{
        observe(events, 2)
        20
    }}`
    assert(events == [1, 2])
    assert(rendered == "1:20")
    let shared = [1]
    let captured = `${shared}:${{
        Array.push(shared, 2)
        "after"
    }}`
    assert(captured == "1:after")
    assert(shared == [1, 2])
    let tagged_events = []
    let tagged = render_tag`before${observe(tagged_events, 1)}between${{
        observe(tagged_events, 2)
        20
    }}after`
    assert(tagged_events == [1, 2])
    assert(tagged == "1:20")
    assert(identity_tag`number ${42}` == 42)
    assert(identity_tag`text ${"hello"}` == "hello")
    assert(show_tag`shown ${42}` == "42")
    assert(tag_segments`${1}${2}` == ["", "", ""])
    assert(tags.identity`${42}` == 42)
    assert(tags.identity`${"text"}` == "text")
    assert(tags.shown`${42}` == "42")
    let merged = tags.overlay`${{ x: 20 }}${{ y: 22 }}`
    assert(merged.x + merged.y == 42)
    let absent: { value?: Option[Number] } = {}
    let present: { value?: Option[Number] } = { value: Some(None) }
    assert(((absent, {}) |> tags.merge_pair).value == Option.none())
    assert(((present, {}) |> tags.merge_pair).value == Option.some(Option.none()))
    assert(tags.overlay_value(0, { other: true, value: "old" }, { value: 42 }) == 42)
}

fn dictionary_assignment(value: a, replacement: a) a where a: Num {
    let current = value
    current += {
        let next = replacement
        current = next
        replacement
    }
    current
}

fn assignment_order() {
    assert(dictionary_assignment(10, 99) == 109)
    let current = { value: 1 }
    let original = current
    current.value = {
        let replacement = { value: 2 }
        current = replacement
        42
    }
    assert(original.value == 42)
    assert(current.value == 2)
    let events = []
    let values = [10, 20]
    values[observe(events, 0)] += {
        observe(events, 1)
        values[0] = 99
        2
    }
    assert(events == [0, 1])
    assert(values == [12, 20])
    let nested = [[1], [2]]
    let first = nested[0]
    nested[0][{
        let replacement = [3]
        nested[0] = replacement
        0
    }] = 42
    assert(first == [42])
    assert(nested == [[3], [2]])
}

async fn suspended_index(nested: Array[Array[Number]], events: Array[Number]) Number {
    Array.push(events, 1)
    Task.sleep(1).await
    let target = nested
    target[0] = [99]
    Array.push(events, 2)
    0
}

async fn async_assignment_order() {
    let events = []
    let nested = [[10]]
    let original = nested[0]
    nested[0][suspended_index(nested, events).await] += {
        Array.push(events, 3)
        Task.sleep(1).await
        original[0] = 100
        2
    }
    assert(original == [12])
    assert(nested == [[99]])
    assert(events == [1, 2, 3])
}

async fn async_index_only() {
    let events = []
    let nested = [[10]]
    let original = nested[0]
    nested[0][suspended_index(nested, events).await] = 42
    assert(original == [42])
    assert(nested == [[99]])
}

fn fallible_index() Result[Number, [:index_failed]] { Err(:index_failed) }

fn index_propagation(values: Array[Number]) Result[(), [:index_failed]] {
    let target = values
    target[fallible_index()?] = 42
    Ok(())
}

fn index_return(values: Array[Number]) Number {
    let target = values
    target[{ return 42 }] = 99
    0
}

fn expression_order() {
    let events = []
    let array = [observe(events, 1), {
        observe(events, 2)
        20
    }]
    assert(events == [1, 2])
    assert(array == [1, 20])
    let tuple = (observe(events, 3), {
        observe(events, 4)
        40
    })
    assert(events == [1, 2, 3, 4])
    assert(tuple == (3, 40))
    let arguments = pair(observe(events, 5), {
        observe(events, 6)
        60
    })
    assert(events == [1, 2, 3, 4, 5, 6])
    assert(arguments == (5, 60))
    let exits = []
    assert(operand_return(exits) == 42)
    assert(exits == [1])
    let shared = [1]
    let aliases = [shared, {
        Array.push(shared, 2)
        shared
    }]
    assert(aliases == [[1, 2], [1, 2]])
    let scalar = 1
    let captured = [scalar, {
        let next = 2
        scalar = next
        scalar
    }]
    assert(captured == [1, 2])
}

pub async fn main() {
    call_order.run()
    assert(call_order.with_default(Some(42), 0) == 42)
    assert(call_order.with_default(None, "fallback") == "fallback")
    call_order.verify_async().await
    pattern_capture.run()
    pattern_capture.verify_async().await
    expression_order()
    template_order()
    assert(assignments.identity(42) == 42)
    assert(assignments.identity("text") == "text")
    assert(assignments.forward(41) == 41)
    assignments.writer()()
    assert(assignments.forward(41) == 42)
    let assigned_items = [0]
    let assigned_record = { count: 0 }
    assert(assignments.update(20, assigned_items, assigned_record) == 42)
    assert(assigned_items[0] == 21)
    assert(assigned_record.count == 21)
    assert(assignments.pattern_writes() == 42)
    assignment_order()
    async_assignment_order().await
    async_index_only().await
    let untouched = [10]
    assert(index_return(untouched) == 42)
    assert(untouched == [10])
    match index_propagation(untouched) {
        Ok(_) => { assert(false) },
        Err(:index_failed) => { assert(untouched == [10]) },
    }
    let tagged_task = async_tag`later ${42}`
    assert(tagged_task.await == 42)
    let imported_tagged_task = tags.later`${42}`
    assert(imported_tagged_task.await == 42)
    assert(choose(true) == 42)
    assert(choose(false) == 43)
    assert(mixed(true) == 42)
    assert(mixed(false) == 43)
    assert(matched(true) == 42)
    assert(matched(false) == 43)
    let callback = () -> { return 42 }
    assert(callback() == 42)
    assert(awaited(true).await == 42)
    assert(awaited(false).await == 43)
    assert(loop_tail_return(true) == 42)
    assert(loop_tail_return(false) == 43)
    assert(loop_tail_effects() == 2)
    assert(break_payload_effects() == 1)
    assert(nested_loop_values(true) == 41)
    assert(nested_loop_values(false) == 42)
    assert(awaited_loop_value().await == 42)
    assert(loop_payload_once() == 1)
    assert(while_condition_exits_enclosing_loop() == 42)
    assert(array_operand_exit() == 42)
    assert(annotated_array_operand_exit() == 42)
    assert(tuple_operand_exit() == 42)
    assert(tag_operand_exit() == 42)
    assert(template_operand_exit() == 42)
    assert(tagged_template_operand_exit() == 42)
    assert(index_operand_exit() == 42)
    assert(assignment_operand_exit() == 42)
    assert(record_operand_exit() == 42)
    assert(annotated_record_operand_exit() == 42)
    methods.verify().await
    pins.verify()
    assert(while_condition_continues_enclosing_loop().await == 2)
    let unit = loop { break }
    assert(unit == ())
    assert(short_circuit_loop() == 42)
    assert(guarded_loop(true) == 42)
    assert(guarded_loop(false) == 42)
}
