import (
    ~/compare,
    ~/cycles,
    ~/mutual,
    ~/option_laws,
)

#[derive(Hash)]
enum Box[a] { Value(a) }

#[derive(Show, Hash)]
enum Node { Links(Array[Option[Node]]) }

#[derive(Eq)]
enum Cycle { Link(Array[Option[Cycle]], Number) }

#[derive(Eq)]
enum GenericCycle[a] { Link(Array[GenericCycle[a]], a) }

fn generic_cycle(value: a) GenericCycle[a] {
    let children = []
    let node = GenericCycle::Link(children, value)
    array.push(children, node)
    node
}

fn cycle(value: Number) Cycle {
    let children: Array[Option[Cycle]] = []
    let node = Cycle::Link(children, value)
    array.push(children, Some(node))
    node
}

fn equal(left: a, right: a) where a: Hash {
    assert compare.ordinary(left, right)
    assert compare.ordinary(right, left)
    assert compare.inherited(left, right)
    assert compare.inherited(right, left)
    assert compare.hashes_match(left, right)
}

pub fn main() {
    option_laws.check()
    cycles.check()
    mutual.check()
    assert generic_cycle(42) == generic_cycle(42)
    assert generic_cycle("same") == generic_cycle("same")
    assert !(generic_cycle("left") == generic_cycle("right"))
    let left_cycle = cycle(42)
    let right_cycle = cycle(42)
    assert left_cycle == left_cycle
    assert left_cycle == right_cycle
    assert right_cycle == left_cycle
    assert !(left_cycle == cycle(7))
    let nan_cycle = cycle(0 / 0)
    assert !(nan_cycle == nan_cycle)
    let tree = Node::Links([Some(Node::Links([])), None])
    let twin = Node::Links([Some(Node::Links([])), None])
    equal(tree, twin)
    assert show(tree) == "Links([Some(Links([])), None])"
    assert !(tree == Node::Links([]))
    let text = "a😀"
    let count = 0
    while count < 16 {
        text = string.concat(text, text)
        count += 1
    }
    equal(text, string.concat(text, ""))
    equal(Some(text), Some(string.concat(text, "")))
    equal(0, -0)
    equal((), ())
    equal(true, true)
    equal("same", "same")
    equal(42n, 42n)
    equal(1 / 0, 1 / 0)
    equal(-1 / 0, -1 / 0)
    let positive: Option[Option[Number]] = Some(Some(0))
    let negative: Option[Option[Number]] = Some(Some(-0))
    equal(positive, negative)
    equal([positive], [negative])
    equal(Box::Value(positive), Box::Value(negative))
    let nan = 0 / 0
    assert !compare.ordinary(nan, nan)
    assert !compare.inherited(nan, nan)
    let nested: Option[Option[Number]] = Some(Some(nan))
    assert !compare.ordinary(nested, nested)
    assert !compare.inherited(nested, nested)
    assert !compare.inherited([nested], [nested])
    assert !compare.inherited(Box::Value(nested), Box::Value(nested))
}
