import (
    json,
    ref,
    result as results,

    ~/array_iterators,
    ~/codec,
    ~/facade,
    ~/facade.{Parcel, Wrap, Extract, extract},
    ~/facade.{read_value as read},
    ~/function_instances,
    ~/hash_dictionaries,
    ~/initialize_a,
    ~/initialize_z,
    ~/option_constructors,
    ~/optional_arguments,
    ~/ordering_evidence,
    ~/overlay_contracts,
    ~/public_types,
    ~/record_instances,
    ~/result_instances,
    ~/result_instances.{Second},
    ~/structural_errors,
)

#[derive(Show, Ord, Hash, Json)]
enum Status {
    Ready,
    Failed(String),
    Meta { code: Number, note: String },
}

#[derive(Json)]
enum Config {
    Config { name: String, note?: String },
}

#[derive(Show, Hash, Json)]
enum OptionalPayload { Value { items?: Array[Number], nested?: Option[Number], unit?: () } }

#[derive(Ord)]
enum OptionalOrder { Value { value?: Number } }

#[derive(Ord)]
enum OrderProbe {
    Value { zed: Number, alpha: Number },
}

#[derive(Hash)]
enum FirstHashProbe {
    Value { payload: Number },
}

#[derive(Hash)]
enum SecondHashProbe {
    Value { payload: Number },
}

enum Secret { Secret }

#[derive(Show, Hash, Json)]
enum OptionalBox { Box(Option[Option[Option[Number]]]) }

enum NamedSome { Some(Number) }

impl Show[Secret] {
    fn show(value: Secret) String { "redacted" }
}

impl Hash[Secret] {
    fn hash(value: Secret) BigInt { 23n }
}

impl Json[Secret] {
    fn encode(value: Secret) String { "\"secret\"" }
    fn decode(value: String) Result[Secret, [:invalid_json(String)]] { results.ok(Secret::Secret) }
}

#[derive(Show)]
enum SecretBox { SecretBox(Secret) }

#[derive(Show, Hash, Json)]
enum NestedSecretBox { NestedSecretBox(Array[Option[Secret]]) }

enum Reverse { Low, High }

impl Ord[Reverse] {
    fn compare(left: Reverse, right: Reverse) Ordering {
        if left == right {
            Ordering::Equal
        } else if left == Reverse::High {
            Ordering::Less
        } else {
            Ordering::Greater
        }
    }
}

#[derive(Ord)]
enum ReverseBox { ReverseBox(Reverse) }

enum HashSecret { First, Second }

impl Hash[HashSecret] {
    fn hash(value: HashSecret) BigInt { 7n }
}

#[derive(Hash)]
enum HashSecretBox { HashSecretBox(HashSecret) }

enum JsonSecret { JsonSecret }

impl Json[JsonSecret] {
    fn encode(value: JsonSecret) String { "\"secret\"" }
    fn decode(value: String) Result[JsonSecret, [:invalid_json(String)]] { results.ok(JsonSecret::JsonSecret) }
}

#[derive(Json)]
enum JsonSecretBox { JsonSecretBox(JsonSecret) }

error Failure {
    :later,
    :first(Number),
}

#[derive(Show, Ord, Hash, Json)]
enum Chain {
    End,
    Link(Number, Chain),
}

trait Describe[a] {
    fn describe(value: a) String
}

impl Describe[Number] {
    fn describe(value: Number) String { "number" }
}

impl Describe[String] {
    fn describe(value: String) String { value }
}

impl Describe[Array[a]] where a: Describe {
    fn describe(value: Array[a]) String { "array" }
}

fn describe_generic(value: a) String where a: Describe {
    describe(value)
}

fn invoke(renderer: fn(a) String, value: a) String {
    renderer(value)
}

fn describe_indirect(value: a) String where a: Describe {
    invoke(describe, value)
}

fn describe_scoped(value: a) String where a: Describe {
    let render = (other: a) String -> describe(other)
    render(value)
}

trait MethodContract[a] {
    fn inherited(value: a, other: b) String where b: Describe
    fn reordered(value: a, other: b) String where b: Describe + Show
}

impl MethodContract[Number] {
    fn inherited(value: Number, other: c) String { describe(other) }
    fn reordered(value: Number, other: c) String where c: Show + Describe {
        describe(other)
    }
}

fn lift(value: a) f[a] where f: Applicative {
    pure(value)
}

fn apply_generic(function: f[fn(a) b], value: f[a]) f[b] where f: Applicative {
    apply(function, value)
}

fn less_than(left: a, right: a) Bool where a: Ord {
    left < right
}

fn verify_error_group_capabilities() Result[(), [:invalid_json(String)]] {
    let failure: Failure = decode("{\"tag\":\":first\",\"fields\":[42]}")?
    let same_failure: Failure = decode("{\"tag\":\":first\",\"fields\":[42]}")?
    let later: Failure = decode("{\"tag\":\":later\",\"fields\":[]}")?
    assert(failure == same_failure)
    assert(later != failure)
    assert(show(failure) == ":first(42)")
    assert(hash(failure) == hash(same_failure))
    assert(encode(failure) == "{\"tag\":\":first\",\"fields\":[42]}")
    let decoded_failure: Result[Failure, [:invalid_json(String)]] = decode(encode(failure))
    assert(decoded_failure == results.ok(failure))
    results.ok(())
}

fn verify_option_representation() {
    let left: Option[Option[Option[Number]]] = option.some(option.some(option.none()))
    let right: Option[Option[Option[Number]]] = option.some(option.some(option.none()))
    assert(left == right)
    assert(show(left) == "Some(Some(None))")
    assert(hash(left) == hash(right))
    assert(OptionalBox::Box(left) == OptionalBox::Box(right))
    let roundtrip: Result[OptionalBox, [:invalid_json(String)]] = decode(encode(OptionalBox::Box(left)))
    assert(roundtrip == results.ok(OptionalBox::Box(right)))
    let mapped: Option[Option[Number]] = option.map(option.some(42), x -> option.none())
    assert(mapped == option.some(option.none()))
    assert(mapped != option.none())
    let values: Map[String, Option[Number]] = map.new()
    map.set(values, "present", option.none())
    assert(map.get(values, "present") == option.some(option.none()))
    assert(map.get(values, "absent") == option.none())
    let named = option.some(NamedSome::Some(42))
    assert(option.map(named, x -> x) == named)
}

fn same_optional_arrays(left: { items?: Array[Number] }, right: { items?: Array[Number] }) Bool {
    left == right
}

fn verify_optional_payload_operations() {
    assert(same_optional_arrays({}, {}))
    assert(!same_optional_arrays({}, { items: [] }))
    assert(same_optional_arrays({ items: [1] }, { items: [1] }))
    let absent = OptionalPayload::Value {}
    let present_none = OptionalPayload::Value { nested: option.some(option.none()) }
    let present_unit = OptionalPayload::Value { unit: () }
    assert(absent == OptionalPayload::Value {})
    assert(absent == OptionalPayload::Value { nested: option.none() })
    assert(absent != present_none && present_none != absent)
    assert(absent != present_unit && present_unit != absent)
    assert(hash(absent) == hash(OptionalPayload::Value {}))
    assert(hash(present_none) == hash(OptionalPayload::Value { nested: option.some(option.none()) }))
    assert(show(present_none) == "Value { items: None, nested: Some(None), unit: None }")
    let none_json = json.encode(present_none)
    assert(none_json == "{\"tag\":\"Value\",\"value\":{\"items\":null,\"nested\":{\"$alderSome\":null},\"unit\":null}}")
    let decoded_none: Result[OptionalPayload, [:invalid_json(String)]] = json.decode(none_json)
    assert(decoded_none == Ok(present_none))
    let decoded_unit: Result[OptionalPayload, [:invalid_json(String)]] = json.decode(json.encode(present_unit))
    assert(decoded_unit == Ok(present_unit))
    let imported_none: Result[OptionalPayload, [:invalid_json(String)]] = codec.decode_value(codec.encode_value(present_none))
    assert(imported_none == Ok(present_none))
    assert(OptionalOrder::Value {} == OptionalOrder::Value {})
    assert(OptionalOrder::Value {} < OptionalOrder::Value { value: 1 })
    assert(OptionalOrder::Value { value: 1 } > OptionalOrder::Value {})
}

pub fn main() {
    ordering_evidence.run()
    array_iterators.run()
    assert(array_iterators.advance(array.iter([42])) == option.some(42))
    let overlay_left = { value: 0, extra: true }
    let overlay_right = { value: "discarded", other: false }
    assert(overlay_contracts.overlay_read(0, overlay_left, overlay_right) == 42)
    assert(overlay_contracts.overlay_read("marker", overlay_left, overlay_right) == 7)
    assert(overlay_contracts.overlay_read(0, { value: 1, extra: "text" }, { value: false, other: true }) == 42)
    assert(overlay_contracts.overlay_read("marker", { value: 1, extra: "text" }, { value: false, other: true }) == 7)
    assert(overlay_left.value == 0)
    assert(overlay_right.value == "discarded")
    structural_errors.run()
    hash_dictionaries.run()
    optional_arguments.check()
    assert(optional_arguments.relay_universal(42) == 42)
    assert(optional_arguments.relay_tuple_before((42, 7)) == (42, 7))
    assert(optional_arguments.relay_tuple_before((42, "kept")) == (42, "kept"))
    assert(optional_arguments.relay_tuple_after((42, 7)) == (42, 7))
    assert(optional_arguments.relay_tuple_after((42, "kept")) == (42, "kept"))
    assert(optional_arguments.relay_universal("hello") == "hello")
    let absent_universal: Option[Number] = None
    assert(optional_arguments.relay_universal(absent_universal) == None)
    let original_failure: Result[Number, [:bad]] = Err(:bad)
    let lifted_failure = match original_failure {
        Err(failure) => optional_arguments.relay_failure(failure),
        Ok(value) => Ok(value),
    }
    assert(lifted_failure == Err(:bad))
    assert(optional_arguments.preserve() == None)
    assert(optional_arguments.preserve(option.some(None)) == option.some(None))
    result_instances.check()
    let imported_result: Result[Number, Second] = Err(:failed(9))
    assert(result_instances.preserve_result(imported_result) == imported_result)
    let increment = (value: Number) Number -> value + 1
    assert(function_instances.invoke(increment) == 42)
    assert(function_instances.select(0, 42) == 42)
    assert(function_instances.select(0, "hello") == "hello")
    assert(function_instances.select("default", 7) == 7)
    assert(function_instances.select("default", "world") == "world")
    let same_number = function_instances.preserve(increment)
    let same_text = function_instances.preserve((value: String) String -> value)
    assert(same_number(41) == 42)
    assert(same_text("hello") == "hello")
    assert(function_instances.nested([option.some(42)]) == [option.some(42)])
    assert(function_instances.nested([["hello"]]) == [["hello"]])
    let nested_results: Array[Result[Number, [:failed]]] = [Ok(42), Err(:failed)]
    assert(function_instances.nested(nested_results) == nested_results)
    assert(record_instances.read_x({ x: 42, label: "extra" }) == 42)
    assert(record_instances.read_x({ x: 7 }) == 7)
    let omitted: { value?: Option[Number] } = {}
    let present_none: { value?: Option[Number] } = { value: option.some(None) }
    let present_number: { value?: Option[Number] } = { value: option.some(42) }
    assert(record_instances.read_optional(omitted) == None)
    assert(record_instances.read_optional(present_none) == option.some(None))
    assert(record_instances.read_optional(present_number) == option.some(option.some(42)))
    option_constructors.verify()
    let wrapped_named_some: Option[NamedSome] = Option::Some(NamedSome::Some(42))
    assert(match wrapped_named_some { Option::Some(NamedSome::Some(42)) => true, _ => false })
    verify_optional_payload_operations()
    let first_error: Result[Number, [:payload(Number, String)]] = Err(:payload(1, "first"))
    let different_number: Result[Number, [:payload(Number, String)]] = Err(:payload(2, "first"))
    let different_text: Result[Number, [:payload(Number, String)]] = Err(:payload(1, "second"))
    let same_error: Result[Number, [:payload(Number, String)]] = Err(:payload(1, "first"))
    assert(first_error != different_number)
    assert(first_error != different_text)
    assert(first_error == same_error)
    assert(same_error == first_error)
    assert(option.some(first_error) != option.some(different_text))
    assert(ref.same(facade.numbers, facade.same_numbers))
    assert(ref.same(facade.numbers, public_types.shared))
    facade.append(2)
    array.push(facade.same_numbers, 3)
    // Independent imports initialize in canonical module-path order (a, z).
    assert(public_types.shared == [1, -1, 0, 5, 4, 2, 3])
    let parcel: Wrap[Parcel[Number]] = { value: Parcel::Packet(42) }
    assert(extract(parcel.value) == 42)
    assert(Extract::value(parcel.value) == 42)
    assert(facade.read_value(parcel.value) == 42)
    assert(facade.read_again(parcel.value) == 42)
    assert(read(parcel.value) == 42)
    assert(facade.describe(42) == "42")
    assert(codec.describe(42) == "42")
    let module_number: Result[Number, [:invalid_json(String)]] = json.decode("\"not a number\"")
    assert(match module_number { Ok(_) => false, Err(:invalid_json(_)) => true })
    let decode_number = json.decode
    let indirect_number: Result[Number, [:invalid_json(String)]] = decode_number("\"bad\"")
    assert(match indirect_number { Ok(_) => false, Err(:invalid_json(_)) => true })
    let imported_number: Result[Number, [:invalid_json(String)]] = codec.decode_value("\"bad\"")
    assert(match imported_number { Ok(_) => false, Err(:invalid_json(_)) => true })
    let imported_valid: Result[Number, [:invalid_json(String)]] = codec.decode_value(codec.encode_value(42))
    assert(imported_valid == Ok(42))
    assert(json.encode(JsonSecret::JsonSecret) == "\"secret\"")
    let custom_json: Result[JsonSecret, [:invalid_json(String)]] = codec.decode_value(codec.encode_value(JsonSecret::JsonSecret))
    assert(custom_json == Ok(JsonSecret::JsonSecret))
    let inherited_json_tag: Result[Config, [:invalid_json(String)]] = json.decode("{\"tag\":\"toString\",\"fields\":[]}")
    assert(inherited_json_tag == Err(:invalid_json("$.tag: unknown variant \"toString\"")))
    let module_nested: Result[Array[Number], [:invalid_json(String)]] = json.decode("[1,\"bad\"]")
    assert(module_nested == Err(:invalid_json("$[1]: expected a JSON number")))
    let wrong_number: Result[Number, [:invalid_json(String)]] = decode("\"not a number\"")
    assert(match wrong_number { Ok(_) => false, Err(:invalid_json(_)) => true })
    let wrong_string: Result[String, [:invalid_json(String)]] = decode("42")
    assert(match wrong_string { Ok(_) => false, Err(:invalid_json(_)) => true })
    let wrong_bool: Result[Bool, [:invalid_json(String)]] = decode("[]")
    assert(match wrong_bool { Ok(_) => false, Err(:invalid_json(_)) => true })
    let wrong_array: Result[Array[Number], [:invalid_json(String)]] = decode("[1,\"bad\"]")
    assert(wrong_array == Err(:invalid_json("$[1]: expected a JSON number")))
    let wrong_field: Result[Status, [:invalid_json(String)]] = decode("{\"tag\":\"Meta\",\"value\":{\"code\":\"bad\",\"note\":\"ok\"}}")
    assert(wrong_field == Err(:invalid_json("$.value.code: expected a JSON number")))
    let number: Result[Number, [:invalid_json(String)]] = decode("42")
    assert(number == Ok(42))
    let boolean: Result[Bool, [:invalid_json(String)]] = decode("true")
    assert(boolean == Ok(true))
    let big = 123456789012345678901234567890n
    assert(encode(big) == "\"123456789012345678901234567890\"")
    let decoded_big: Result[BigInt, [:invalid_json(String)]] = decode(encode(big))
    assert(decoded_big == Ok(big))
    assert(encode(()) == "null")
    let unit: Result[(), [:invalid_json(String)]] = decode("null")
    assert(unit == Ok(()))
    verify_option_representation()
    let identity = { value: 1 }
    let equal_but_distinct = { value: 1 }
    assert(ref.same(identity, identity))
    assert(!ref.same(identity, equal_but_distinct))

    assert(describe_generic(1) == "number")
    assert(describe_generic("text") == "text")
    assert(describe_generic([1, 2]) == "array")
    assert(describe_indirect(1) == "number")
    assert(describe_scoped(1) == "number")
    assert(describe_scoped("text") == "text")
    assert(inherited(0, 42) == "number")
    assert(inherited(0, "text") == "text")
    assert(reordered(0, 42) == "number")

    assert(show(Status::Failed("oops")) == "Failed(\"oops\")")
    assert(show(Status::Meta { code: 7, note: "same" }) == "Meta { code: 7, note: \"same\" }")
    assert(Status::Ready < Status::Failed("later"))
    assert(match compare(1, 2) {
        Ordering::Less => true,
        _ => false,
    })
    assert(compare(2, 2) == Ordering::Equal)
    assert(less_than(1, 2))
    assert(less_than(Reverse::High, Reverse::Low))
    assert(OrderProbe::Value { zed: 0, alpha: 9 } < OrderProbe::Value { zed: 1, alpha: 0 })
    assert(hash(Status::Meta { code: 7, note: "same" }) == hash(Status::Meta { code: 7, note: "same" }))
    assert(hash(Status::Meta { code: 7, note: "same" }) != hash(Status::Meta { code: 8, note: "same" }))
    assert(hash(FirstHashProbe::Value { payload: 1 }) != hash(SecondHashProbe::Value { payload: 1 }))
    assert(show(SecretBox::SecretBox(Secret::Secret)) == "SecretBox(redacted)")
    let nested_secret = NestedSecretBox::NestedSecretBox([option.some(Secret::Secret), option.none()])
    assert(show(nested_secret) == "NestedSecretBox([Some(redacted), None])")
    assert(encode(nested_secret) == "{\"tag\":\"NestedSecretBox\",\"fields\":[[\"secret\",null]]}")
    let decoded_nested_secret: Result[NestedSecretBox, [:invalid_json(String)]] = decode(encode(nested_secret))
    assert(decoded_nested_secret == results.ok(nested_secret))
    assert(hash(nested_secret) == hash(NestedSecretBox::NestedSecretBox([option.some(Secret::Secret), option.none()])))
    assert(ReverseBox::ReverseBox(Reverse::High) < ReverseBox::ReverseBox(Reverse::Low))
    assert(hash(HashSecretBox::HashSecretBox(HashSecret::First)) == hash(HashSecretBox::HashSecretBox(HashSecret::Second)))

    let secret_json = encode(JsonSecretBox::JsonSecretBox(JsonSecret::JsonSecret))
    assert(secret_json == "{\"tag\":\"JsonSecretBox\",\"fields\":[\"secret\"]}")
    let decoded_secret: Result[JsonSecretBox, [:invalid_json(String)]] = decode(secret_json)
    assert(decoded_secret == results.ok(JsonSecretBox::JsonSecretBox(JsonSecret::JsonSecret)))

    assert(verify_error_group_capabilities() == results.ok(()))

    let chain = Chain::Link(1, Chain::Link(2, Chain::End))
    let same_chain = Chain::Link(1, Chain::Link(2, Chain::End))
    assert(chain == same_chain)
    assert(show(chain) == "Link(1, Link(2, End))")
    assert(chain > Chain::End)
    assert(hash(chain) == hash(same_chain))
    let decoded_chain: Result[Chain, [:invalid_json(String)]] = decode(encode(chain))
    assert(decoded_chain == results.ok(chain))

    let encoded = encode(Status::Meta { code: 42, note: "answer" })
    let decoded: Result[Status, [:invalid_json(String)]] = decode(encoded)
    assert(decoded == results.ok(Status::Meta { code: 42, note: "answer" }))

    let config = Config::Config { name: "alder" }
    let config_json = encode(config)
    assert(config_json == "{\"tag\":\"Config\",\"value\":{\"name\":\"alder\",\"note\":null}}")
    let decoded_config: Result[Config, [:invalid_json(String)]] = decode(config_json)
    assert(decoded_config == results.ok(config))
    let extra_config_field: Result[Config, [:invalid_json(String)]] = decode("{\"tag\":\"Config\",\"value\":{\"name\":\"alder\",\"extra\":true}}")
    assert(extra_config_field == results.err(:invalid_json("$.value.extra: unexpected field")))
    let extra_config_envelope: Result[Config, [:invalid_json(String)]] = decode("{\"tag\":\"Config\",\"value\":{\"name\":\"alder\"},\"extra\":true}")
    assert(extra_config_envelope == results.err(:invalid_json("$: expected only `tag` and `value`")))

    let mapped: Option[Number] = map(option.some(1), (value) -> { value + 1 })
    assert(mapped == option.some(2))

    let mapped_array: Array[Number] = map([1, 2], (value) -> { value + 1 })
    assert(mapped_array == [2, 3])

    let result: Result[Number, [:test(String)]] = results.ok(1)
    let mapped_result: Result[Number, [:test(String)]] = map(result, (value) -> { value + 1 })
    assert(mapped_result == results.ok(2))

    let pure_option: Option[Number] = lift(4)
    assert(pure_option == option.some(4))

    let array_functions: Array[fn(Number) Number] = [
        (value) -> { value + 1 },
        (value) -> { value * 2 },
    ]
    let applied_array: Array[Number] = apply(array_functions, [2, 3])
    assert(applied_array == [3, 4, 4, 6])

    let option_function: Option[fn(Number) Number] = option.some((value) -> { value + 1 })
    let applied_option: Option[Number] = apply_generic(option_function, option.some(2))
    assert(applied_option == option.some(3))

    let bound_array: Array[Number] = flat_map([1, 2], (value) -> { [value, value + 10] })
    assert(bound_array == [1, 11, 2, 12])

    let traversed_array: Option[Array[Number]] = traverse(
        [1, 2],
        (value) -> { option.some(value + 1) },
    )
    assert(traversed_array == option.some([2, 3]))

    let first: Option[Number] = next(array.iter([7, 8]))
    let empty: Option[Number] = next(array.iter([]))
    assert(first == option.some(7))
    assert(empty == option.none())
}
