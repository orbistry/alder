---
source: crates/alder-parse/src/module.rs
description: "fn profile(id: Id) -> Result[Profile] {\n    let user = Http.get(`/users/${id}`).await?\n    let posts = Http.get(`/users/${id}/posts`).await?\n    Ok({ user, posts })\n}\n\nlet (a, b) = Fiber.all(profile(1), profile(2)).await\n"
