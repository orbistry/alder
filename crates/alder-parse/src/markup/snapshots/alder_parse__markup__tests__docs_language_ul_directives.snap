---
source: crates/alder-parse/src/markup/mod.rs
description: "<ul class={styles.list}>\n    @for item in items; key item.id {\n        <li>{item.name}</li>\n    } @empty {\n        <li>Nothing here</li>\n    }\n    @if status.loading {\n        <Spinner />\n    } @else if status.failed {\n        <p>Something went wrong</p>\n    } @else {\n        <p>{count} items</p>\n    }\n    @match status {\n        Loading => <Spinner />,\n        Ready(n) => <span>{n}</span>,\n    }\n</ul>\n"
