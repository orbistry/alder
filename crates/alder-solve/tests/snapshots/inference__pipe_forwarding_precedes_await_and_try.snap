source: crates/alder-solve/tests/inference.rs
description: "fn load(value: Number) Result[Number] {\n    Task.sleep(1).await\n    Ok(value)\n}\n\nfn run() Result[Number] {\n    let value = 42 |> load().await?\n    Ok(value)\n}\n"
